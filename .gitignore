# Python
__pycache__/
*.py[cod]
.pytest_cache/

# OS / editor
.DS_Store

# Trained weights / checkpoints — regenerable from the logged runs, not source.
# Keep the .csv/.json/.log next to them (the actual experiment record).
checkpoints/
*.pt
*.pth

# Stray WebRTC livestream recordings (spike/quick_look.py), written next to
# a literal unexpanded "${data}" dir when run outside the intended cwd.
${data}/

# Rendered demo videos — regenerable from spike/record_video.py + the
# committed checkpoints, and re-recording every variant would permanently
# bloat history. Extracted stills ARE kept (they are figures). Force-add a
# specific cut with `git add -f` when one accompanies a submission.
plots/*.mp4
